              "name": "party_size",
              "type": "number",
              "value": "={{ String($json.body?.attending ?? \"\").toLowerCase() === \"yes\" ? Math.max(1, Math.min(2, Number($json.body?.party_size ?? 1))) : 0 }}"
            },
            {
              "id": "plus_one_name",
              "name": "plus_one_name",
              "type": "string",
              "value": "={{ Number($json.body?.party_size ?? 1) >= 2 ? (($json.body?.plus_one_first_name ?? \"\") + \" \" + ($json.body?.plus_one_last_name ?? \"\")).trim() : \"\" }}"
            },
            {
              "id": "dietary",
              "name": "dietary",
              "type": "string",
              "value": "={{ ($json.body?.dietary ?? \"\").trim() }}"
            },
            {
              "id": "song_request",
              "name": "song_request",
              "type": "string",
              "value": "={{ ($json.body?.song_request ?? \"\").trim() }}"
            },
            {
              "id": "message",
              "name": "message",
              "type": "string",
              "value": "={{ ($json.body?.message ?? \"\").trim() }}"
            },
            {
              "id": "honeypot",
              "name": "honeypot",
              "type": "string",
              "value": "={{ String($json.body?.honeypot ?? \"\") }}"
            },
            {
              "id": "ip",
              "name": "ip",
              "type": "string",
              "value": "={{ $json.headers?.[\"cf-connecting-ip\"] ?? $json.headers?.[\"x-forwarded-for\"] ?? \"\" }}"
