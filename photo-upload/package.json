{
  "name": "wedding-photo-upload",
  "private": true,
  "version": "0.1.0",
  "description": "Guest photo/video upload for the wedding — Cloudflare Worker + R2 + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute wedding-photos --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute wedding-photos --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "typescript": "^5",
    "wrangler": "^3"
  }
}
